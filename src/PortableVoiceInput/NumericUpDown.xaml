<UserControl x:Class="PortableVoiceInput.NumericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" MinHeight="25">
    <UserControl.Resources>
        <Style TargetType="RepeatButton">
            <Setter Property="Background" Value="#353C50"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#525B71"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#6865BF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{StaticResource FieldBrush}" BorderBrush="#525A6A" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="17"/></Grid.ColumnDefinitions>
            <TextBox x:Name="InputBox" Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     BorderThickness="0" MinHeight="0" Padding="4,2,0,2" VerticalContentAlignment="Center"
                     PreviewTextInput="InputBox_PreviewTextInput" PreviewKeyDown="InputBox_PreviewKeyDown"
                     DataObject.Pasting="InputBox_Pasting"/>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <RepeatButton Click="Increase_Click" ToolTip="{DynamicResource IncreaseValue}" AutomationProperties.Name="{DynamicResource IncreaseValue}">
                    <Path Data="M 0 4 L 4 0 L 8 4 Z" Fill="#E4E7F0" Width="8" Height="4" Stretch="Fill"/>
                </RepeatButton>
                <RepeatButton Grid.Row="1" Click="Decrease_Click" ToolTip="{DynamicResource DecreaseValue}" AutomationProperties.Name="{DynamicResource DecreaseValue}">
                    <Path Data="M 0 0 L 8 0 L 4 4 Z" Fill="#E4E7F0" Width="8" Height="4" Stretch="Fill"/>
                </RepeatButton>
            </Grid>
        </Grid>
    </Border>
</UserControl>
